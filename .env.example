# Адрес push-сервиса
PUSH_BASE_URL=http://192.168.20.31:7777
# path  -> GET  /push/{login}/{message}   (как в старом проекте)
# query -> GET  /push?login=..&message=..
# json  -> POST /push {"login": .., "message": ..}
PUSH_MODE=path
# Одновременных запросов
PUSH_CONCURRENCY=5
# Таймаут ответа, сек
PUSH_TIMEOUT=15
# Повторы при ошибке соединения (запрос точно не ушёл)
PUSH_CONNECT_RETRIES=3

MIN_LOGIN_DIGITS=9
MAX_LOGIN_DIGITS=15
MAX_UPLOAD_MB=50

# Логи: DEBUG | INFO | WARNING | ERROR; файлы в data/logs/
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

HOST=0.0.0.0
PORT=5001
